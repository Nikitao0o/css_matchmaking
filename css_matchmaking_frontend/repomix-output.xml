import { createContext, useCallback, useContext, useMemo, useState, type ReactNode } from 'react';
import { currentPlayer } from '../data/mock';
import type { Player } from '../types';

interface AuthUser {
  email: string;
  player: Player;
}

interface AuthContextValue {
  user: AuthUser | null;
  /** Mock implementation – replace with a real API call. */
  login: (email: string, password: string, remember: boolean) => Promise<void>;
  register: (playerName: string, email: string, password: string) => Promise<void>;
  logout: () => void;
}

const STORAGE_KEY = 'mm.user';
const AuthContext = createContext<AuthContextValue | null>(null);

function readStored(): AuthUser | null {
  try {
    const raw = localStorage.getItem(STORAGE_KEY) ?? sessionStorage.getItem(STORAGE_KEY);
    return raw ? (JSON.parse(raw) as AuthUser) : null;
  } catch {
    return null;
  }
}

function store(user: AuthUser | null, remember: boolean) {
  try {
    localStorage.removeItem(STORAGE_KEY);
    sessionStorage.removeItem(STORAGE_KEY);
    if (user) (remember ? localStorage : sessionStorage).setItem(STORAGE_KEY, JSON.stringify(user));
  } catch {
    /* storage unavailable – keep in memory only */
  }
}

export function AuthProvider({ children }: { children: ReactNode }) {
  const [user, setUser] = useState<AuthUser | null>(readStored);

  const login = useCallback<AuthContextValue['login']>(async (email, _password, remember) => {
    const next = { email, player: currentPlayer };
    store(next, remember);
    setUser(next);
  }, []);

  const register = useCallback<AuthContextValue['register']>(async (playerName, email) => {
    const next: AuthUser = {
      email,
      player: { ...currentPlayer, name: playerName, initials: playerName.slice(0, 2).toUpperCase() },
    };
    store(next, true);
    setUser(next);
  }, []);

  const logout = useCallback(() => {
    store(null, false);
    setUser(null);
  }, []);

  const value = useMemo(() => ({ user, login, register, logout }), [user, login, register, logout]);
  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
}

export function useAuth(): AuthContextValue {
  const ctx = useContext(AuthContext);
  if (!ctx) throw new Error('useAuth must be used inside <AuthProvider>');
  return ctx;
}
</file>

