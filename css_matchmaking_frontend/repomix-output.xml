const LEVEL_STEP = 100; // mock: one level per 100 ELO

const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

export default function PlayPage() {
  const { user } = useAuth();
  const me = user!.player;

  const [mode, setMode] = useState(gameModes[0]);
  const [party, setParty] = useState<PartySlot[]>(() =>
    initialParty.map((s) => (s.kind === 'player' && s.leader ? { ...s, player: me } : s)),
  );
  const [searching, setSearching] = useState(false);
  const [elapsed, setElapsed] = useState(0);
  const [inviteOpen, setInviteOpen] = useState(false);
  const [inviteName, setInviteName] = useState('');
  const [toast, setToast] = useState<string | null>(null);

  useEffect(() => {
    if (!searching) return;
    setElapsed(0);
    const id = window.setInterval(() => setElapsed((t) => t + 1), 1000);
    return () => window.clearInterval(id);
  }, [searching]);

  const members = party.filter((s): s is Extract<PartySlot, { kind: 'player' }> => s.kind === 'player');
  const partyRating = useMemo(
    () => (members.length ? Math.round(members.reduce((sum, m) => sum + m.player.elo, 0) / members.length) : 0),
    [members],
  );
  const toNext = LEVEL_STEP - (me.elo % LEVEL_STEP);
  const progress = ((me.elo % LEVEL_STEP) / LEVEL_STEP) * 100;

  const clearSlot = (i: number) => setParty((p) => p.map((s, idx) => (idx === i ? { kind: 'empty' as const } : s)));

  const addInvite = () => {
    const name = inviteName.trim();
    if (!name) return;
    setParty((p) => {
      const idx = p.findIndex((s) => s.kind === 'empty');
      return idx === -1 ? p : p.map((s, i) => (i === idx ? { kind: 'pending' as const } : s));
    });
    setToast(`Invite sent to ${name}`);
    setInviteName('');
    setInviteOpen(false);
  };

  const copyLink = async () => {
    try {
      await navigator.clipboard.writeText(`${window.location.origin}/play?party=${encodeURIComponent(me.name)}`);
      setToast('Invite link copied');
    } catch {
      setToast('Could not copy the link');
    }
  };

  const hasEmpty = party.some((s) => s.kind === 'empty');

  return (
    <Panel title="Find a match" centerTitle caption="Counter-Strike:Source">
      {/* Player summary */}
      <Box sx={{ p: 2.5 }}>
        <Stack direction="row" alignItems="center" spacing={2.5} flexWrap="wrap" useFlexGap>
          <PlayerAvatar initials={me.initials} size={40} />
          <Box sx={{ minWidth: 150 }}>
            <Typography sx={{ fontWeight: 600 }}>{me.name}</Typography>
            <Typography variant="caption">
              {me.country} · Member since 2023
            </Typography>
          </Box>

          <Typography sx={{ fontSize: 24, fontWeight: 600 }}>
            {fmt.format(me.elo)}{' '}
            <Typography component="span" sx={{ fontSize: 12, color: 'text.disabled', fontWeight: 500 }}>
              ELO
            </Typography>
          </Typography>

          <Box sx={{ px: 1, py: 0.5, bgcolor: colors.selected, color: 'primary.main', fontSize: 11, fontWeight: 600, letterSpacing: '0.04em' }}>
            LEVEL {me.level}
          </Box>

          <Stat label="Matches played" value={playerSummary.matches} />
          <Stat label="Win rate" value={`${playerSummary.winRate}%`} />
          <Box>
            <Typography variant="caption">Last 5</Typography>
            <Stack direction="row" spacing={1} sx={{ fontSize: 12, fontWeight: 600 }}>
              {playerSummary.last5.map((r, i) => (
                <span key={i}>{r}</span>
              ))}
            </Stack>
          </Box>
        </Stack>

        <LinearProgress variant="determinate" value={progress} sx={{ mt: 2.5 }} aria-label="Progress to next level" />
        <Typography variant="caption" sx={{ display: 'block', mt: 1 }}>
          {toNext} ELO to level {me.level + 1}
        </Typography>
      </Box>

      <Divider />

      {/* Game mode */}
      <Box sx={{ p: 2.5 }}>
        <Typography variant="caption" sx={{ display: 'block', mb: 1 }}>
          Game mode
        </Typography>
        <Select
          fullWidth
          size="small"
          value={mode}
          onChange={(e) => setMode(e.target.value)}
          disabled={searching}
          sx={{ bgcolor: colors.page, fontSize: 13, fontWeight: 500, '& .MuiOutlinedInput-notchedOutline': { borderColor: colors.border } }}
          inputProps={{ 'aria-label': 'Game mode' }}
        >
          {gameModes.map((m) => (
            <MenuItem key={m} value={m}>
              {m}
            </MenuItem>
          ))}
        </Select>
      </Box>

      <Divider />

      {/* Party */}
      <Box sx={{ p: 2.5 }}>
        <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', mb: 2, flexWrap: 'wrap', gap: 1 }}>
          <Typography sx={{ fontWeight: 600 }}>Your party</Typography>
          <Stack direction="row" alignItems="center" spacing={1}>
            <Typography variant="caption" sx={{ mr: 1 }}>
              {members.length} / {PARTY_SIZE} players
            </Typography>
            <Button variant="outlined" size="small" startIcon={<LinkIcon fontSize="small" />} onClick={copyLink}>
              Copy invite link
            </Button>
            <Button variant="outlined" size="small" startIcon={<PersonAddAlt fontSize="small" />} onClick={() => setInviteOpen(true)} disabled={!hasEmpty || searching}>
              Invite player
            </Button>
          </Stack>
        </Box>

        <Box sx={{ border: 1, borderColor: 'divider' }}>
          {party.map((slot, i) => (
            <PartyRow key={i} slot={slot} isYou={slot.kind === 'player' && slot.leader === true} onClear={() => clearSlot(i)} disabled={searching} last={i === party.length - 1} />
          ))}
        </Box>

        <Box sx={{ textAlign: 'center', mt: 2.5 }}>
          <Button
            variant="contained"
            size="large"
            startIcon={<Search />}
            onClick={() => setSearching((s) => !s)}
            sx={{ minWidth: 254 }}
          >
            {searching ? `Searching… ${mmss(elapsed)} · Cancel` : 'Search match'}
          </Button>
          <Typography variant="caption" sx={{ display: 'block', mt: 1.5 }}>
            {queueInfo.inQueue} players in queue · Party rating: {fmt.format(partyRating)} ELO
          </Typography>
        </Box>
      </Box>

      <Dialog open={inviteOpen} onClose={() => setInviteOpen(false)} fullWidth maxWidth="xs">
        <DialogTitle>Invite player</DialogTitle>
        <DialogContent>
          <Box sx={{ pt: 1 }}>
            <Field label="Player name" value={inviteName} onChange={setInviteName} placeholder="Enter a player name" autoFocus />
          </Box>
        </DialogContent>
        <DialogActions sx={{ px: 3, pb: 2 }}>
          <Button variant="outlined" onClick={() => setInviteOpen(false)}>
            Cancel
          </Button>
          <Button variant="contained" onClick={addInvite} disabled={!inviteName.trim()}>
            Send invite
          </Button>
        </DialogActions>
      </Dialog>

      <Snackbar open={toast !== null} autoHideDuration={2500} onClose={() => setToast(null)} message={toast} anchorOrigin={{ vertical: 'bottom', horizontal: 'center' }} />
    </Panel>
  );
}

function Divider() {
  return <Box sx={{ mx: 2.5, borderTop: 1, borderColor: 'divider' }} />;
}

function Stat({ label, value }: { label: string; value: string | number }) {
  return (
    <Box>
      <Typography variant="caption">{label}</Typography>
      <Typography sx={{ fontSize: 13, fontWeight: 600 }}>{value}</Typography>
    </Box>
  );
}

interface RowProps {
  slot: PartySlot;
  isYou: boolean;
  last: boolean;
  disabled: boolean;
  onClear: () => void;
}

function PartyRow({ slot, isYou, last, disabled, onClear }: RowProps) {
  const base = {
    display: 'grid',
    gridTemplateColumns: '40px minmax(120px,170px) 60px 130px 1fr 32px',
    alignItems: 'center',
    columnGap: 1.5,
    height: 46,
    px: 1.5,
    fontSize: 13,
    borderBottom: last ? 0 : `1px solid ${colors.border}`,
    bgcolor: isYou ? colors.selected : 'transparent',
  } as const;

  if (slot.kind === 'player') {
    const { player, ready, leader } = slot;
    return (
      <Box sx={base}>
        <PlayerAvatar initials={player.initials} size={28} />
        <Typography sx={{ fontWeight: 600, fontSize: 13 }}>
          {player.name}
          {leader && ' (you)'}
        </Typography>
        <Box sx={{ color: 'text.disabled', fontSize: 11 }}>{player.countryCode}</Box>
        <Box sx={{ color: 'text.secondary' }}>{fmt.format(player.elo)} ELO</Box>
        <Stack direction="row" alignItems="center" spacing={0.75} sx={{ color: ready ? 'success.main' : 'text.disabled', fontSize: 12 }}>
          <Box sx={{ width: 6, height: 6, borderRadius: '50%', bgcolor: 'currentColor' }} />
          <span>{ready ? 'Ready' : 'Not ready'}</span>
        </Stack>
        {leader ? (
          <EmojiEventsOutlined fontSize="small" sx={{ color: 'text.secondary' }} titleAccess="Party leader" />
        ) : (
          <IconButton size="small" aria-label={`Remove ${player.name}`} onClick={onClear} disabled={disabled} sx={{ color: 'text.disabled' }}>
            <Close fontSize="small" />
          </IconButton>
        )}
      </Box>
    );
  }

  const pending = slot.kind === 'pending';
  return (
    <Box sx={{ ...base, color: 'text.disabled' }}>
      <PlayerAvatar initials={pending ? '?' : '+'} size={28} sx={{ color: 'text.disabled' }} />
      <Typography sx={{ fontSize: 13, color: 'inherit' }}>{pending ? 'Waiting for player' : 'Empty slot'}</Typography>
      <Box>—</Box>
      <Box>—</Box>
      <Box sx={{ fontSize: 12 }}>{pending ? 'Wait for player' : 'Invite player'}</Box>
      <IconButton size="small" aria-label="Clear slot" onClick={onClear} disabled={disabled || !pending} sx={{ color: 'text.disabled', visibility: pending ? 'visible' : 'hidden' }}>
        <Close fontSize="small" />
      </IconButton>
    </Box>
  );
}
</file>

