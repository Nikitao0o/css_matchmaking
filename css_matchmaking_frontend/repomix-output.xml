        <Box sx={{ display: 'grid', gap: 3, minWidth: 0 }}>
          <Panel title="Server ready" caption={`Join before ${m.joinBefore}`}>
            <Box sx={{ p: 2 }}>
              <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-end', gap: 2, flexWrap: 'wrap' }}>
