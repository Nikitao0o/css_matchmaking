          '&:hover .MuiOutlinedInput-notchedOutline': { borderColor: colors.muted },
        },
        input: { padding: '12px 12px', fontSize: 13, '&::placeholder': { color: colors.muted, opacity: 1 } },
      },
    },
    MuiTab: {
      styleOverrides: { root: { minHeight: 44, fontWeight: 500, color: colors.muted } },
    },
    MuiTabs: {
      styleOverrides: { root: { minHeight: 44 } },
    },
    MuiLink: {
      defaultProps: { underline: 'hover' },
