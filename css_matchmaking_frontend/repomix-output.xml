import { createTheme } from '@mui/material/styles';
/** Design tokens taken from the Figma exports. */
export const colors = {
  page: '#0F1720',
  header: '#0B1118',
  panel: '#111827',
  border: '#1F2937',
  selected: '#0F2A3D',
  text: '#E2E8F0',
  textSecondary: '#94A3B8',
  muted: '#64748B',
  primary: '#60A5FA',
  success: '#34D399',
  danger: '#A25B5B',
} as const;

export const PAGE_MAX_WIDTH = 1232; // 1184 content + 2 * 24 gutter

export const theme = createTheme({
  palette: {
    mode: 'dark',
    primary: { main: colors.primary, contrastText: '#FFFFFF' },
    success: { main: colors.success },
    error: { main: colors.danger },
    background: { default: colors.page, paper: colors.panel },
    text: { primary: colors.text, secondary: colors.textSecondary, disabled: colors.muted },
    divider: colors.border,
  },
  shape: { borderRadius: 2 },
  typography: {
    fontFamily: '"Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif',
    fontSize: 14,
    h1: { fontSize: 24, fontWeight: 600, letterSpacing: '-0.01em' },
    h2: { fontSize: 20, fontWeight: 600 },
    h3: { fontSize: 14, fontWeight: 600 },
    body1: { fontSize: 14 },
    body2: { fontSize: 13 },
    caption: { fontSize: 12, color: colors.muted },
    button: { textTransform: 'none', fontWeight: 600 },
  },
  components: {
    MuiCssBaseline: {
      styleOverrides: {
        body: { backgroundColor: colors.page },
        a: { color: 'inherit' },
      },
    },
    MuiButton: {
      defaultProps: { disableElevation: true },
      styleOverrides: {
        root: { borderRadius: 2, minHeight: 32 },
        sizeLarge: { minHeight: 44, fontSize: 14 },
        outlined: {
          color: colors.text,
          borderColor: '#334155',
          '&:hover': { borderColor: colors.textSecondary, backgroundColor: 'rgba(148,163,184,0.06)' },
        },
